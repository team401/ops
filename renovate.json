{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>team401/renovate-config"
  ],
  "baseBranches": [
    "staging"
  ],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Automerge verified major updates into staging",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "description": "Hold TypeScript 7 until typescript-eslint supports it",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
