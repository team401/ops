{
  "name": "team401-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/export-pages-output.mjs",
    "start": "vite preview",
    "lint": "eslint",
    "worker:check": "tsc -p workers/api/tsconfig.json",
    "worker:dev": "wrangler dev --config workers/api/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/api/wrangler.jsonc",
    "d1:migrate": "wrangler d1 migrations apply team401-ops --remote --config workers/api/wrangler.jsonc",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@team401/web-ui": "0.4.1",
    "@types/papaparse": "^5.5.2",
    "@vinext/cloudflare": "^1.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.4.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.82.0",
    "next": "16.4.6",
    "papaparse": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.4.7",
    "web-push": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.6",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.0",
    "vite": "^8.4.0",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20261103.1": true,
    "workerd@1.20261123.1": true,
    "workerd@1.20261127.1": true
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "fflate": "0.8.3"
  },
  "type": "module"
}
